<Project>
  <!-- Configurações comuns a todos os projetos da solução -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Avisos de documentação XML (não são bugs; o código compila e funciona igual):
         CS1591: membro público sem nenhum comentário XML.
         CS1573: comentário XML que documenta só ALGUNS parâmetros (comum em records, onde explicamos
                 apenas os campos que precisam de explicação). Desligados em 26/11/2026 para o build ficar limpo
                 e os avisos que importam (ex.: nulos, que aqui já são erro) não se perderem no meio de 100 iguais. -->
    <NoWarn>$(NoWarn);CS1591;CS1573</NoWarn>
  </PropertyGroup>
</Project>
