<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OrcaFacil.Application\OrcaFacil.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.*" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.*">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.*" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.*" />
    <!-- PasswordHasher (hash de senhas) -->
    <PackageReference Include="Microsoft.Extensions.Identity.Core" Version="10.*" />
    <!-- Importação de listas: Excel, Word, PDF e OCR de imagens -->
    <PackageReference Include="ClosedXML" Version="0.*" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.*" />
    <PackageReference Include="PdfPig" Version="0.*" />
    <!-- Geração de PDF (Fase 9). Licença MIT: gratuita inclusive em produto vendido. -->
    <PackageReference Include="PDFsharp-MigraDoc" Version="6.2.*" />
    <!-- Segurança: o PDFsharp traz o System.Security.Cryptography.Pkcs 8.0.1, que tem 2 vulnerabilidades conhecidas
         (GHSA-846f-f764-76mx e GHSA-2fmv-rv2c-59x7, corrigidas na 10.0.13). Referenciar a versão corrigida
         diretamente faz o NuGet usar ela no lugar da antiga ("fixar dependência transitiva"). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.*" />
    <PackageReference Include="Tesseract" Version="5.*" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite aos testes acessar membros "internal" (ex.: AplicarRegrasAntesDeSalvar). -->
    <InternalsVisibleTo Include="OrcaFacil.Tests" />
  </ItemGroup>

  <!-- Pacotes das fases seguintes (adicionados quando cada fase for implementada):
       Fase 7: Microsoft.Extensions.Http.Resilience
       Fase 9: QuestPDF -->

</Project>
